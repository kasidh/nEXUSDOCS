# OPENAI_API_KEY: Required for OpenAI API calls.
# ChatGPT subscriptions do not include API usage; configure billing in the OpenAI API platform.
OPENAI_API_KEY="your_openai_api_key"

# GCS_BUCKET: Required in production for durable project and document uploads.
# Grant the Cloud Run service account object read/write access to this bucket.
GCS_BUCKET="your-nexusdocs-bucket"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
